        "typescript": "5.9.3",
        "vite": "8.1.4"
    },
    "scripts": {
        "build:utils": "yarn workspace @kanaries/rath-utils build",
        "build:scenegraph": "yarn workspace vega-scenegraph build",
        "build:renderer": "yarn workspace vega-painter-renderer build",
        "start": "vite --host",
        "build": "npm run build:utils && npm run build:scenegraph && npm run build:renderer && npm run build:client",
        "buildOnDocker": "npm run build:utils && npm run build:scenegraph && npm run build:renderer && vite build",
        "build:client": "vite build",
        "buildForAnalysis": "vite build --mode analysis --sourcemap",
        "test": "jest -c ./jest.config.js --passWithNoTests --no-cache",
        "analyze": "vite build --mode analysis --sourcemap",
        "count": "cloc --exclude-dir=$(tr '\n' ',' < ../../.clocignore) ."
    },
    "resolutions": {
        "vega-scenegraph": "4.10.1-kanaries-patch"
    },
    "browserslist": {
        "production": [
            "Chrome >= 111",
            "Edge >= 111",
            "Firefox >= 128",
            "Safari >= 16.4"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
